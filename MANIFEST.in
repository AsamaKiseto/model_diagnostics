include LICENSE
include README.md
include MANIFEST.in
include pyproject.toml
include pytest.ini
include tox.ini
include __init__.py
recursive-include base *.py
recursive-include extensions *.py
recursive-include host_runtime *.py
recursive-include integration *.py
recursive-include docs *.md *.css *.py
recursive-include tests *.py
recursive-include .github *.py *.yml
global-exclude __pycache__
global-exclude *.py[cod]
prune .cache
prune build
prune dist
prune src
prune *.egg-info
